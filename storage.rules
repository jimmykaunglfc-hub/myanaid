rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos are private: only the person who owns the profile can
    // upload, view, or replace their own image.
    match /profile-photos/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
