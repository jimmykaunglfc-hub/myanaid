rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in person can access only their own profile and preferences.
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Action Briefs are generated by the server and visible only to the user
    // whose saved locations and source records were used for the explanation.
    match /users/{userId}/actionBriefs/{briefId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // These documents contain public, provider-sourced monitoring data. The
    // Cloud Function writes them with the Admin SDK; browsers can never write.
    match /sourceEvents/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Approximate-area shelter lookup caches contain public provider records.
    // The server writes them; browsers can read but can never alter them.
    match /publicShelterSearches/{searchAreaId} {
      allow read: if true;
      allow write: if false;
    }

    function signedIn() { return request.auth != null; }
    function familyMember(familyId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/familyGroups/$(familyId)).data.memberIds;
    }

    // Family group membership and precise coordinates are created only by
    // authenticated Cloud Functions. Members can read their own group, but
    // browsers cannot grant access, alter sharing state, or forge a location.
    match /familyGroups/{familyId} {
      allow get: if familyMember(familyId);
      allow list, write: if false;
      match /members/{memberId} {
        allow read: if familyMember(familyId);
        allow write: if false;
      }
      match /locations/{memberId} {
        allow read: if familyMember(familyId);
        allow write: if false;
      }
      match /places/{placeId} {
        allow read: if familyMember(familyId);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
