[debug] [2026-10-18T04:01:23.989Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/myanaid-7b3dd/rulesets {"name":"projects/myanaid-7b3dd/rulesets/1ebf7bf6-b996-45f1-8e9f-c2aea87abbc8","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    // Each signed-in person can access only their own profile and preferences.\n    match /users/{userId} {\n      allow create: if request.auth != null && request.auth.uid == userId;\n      allow read, update, delete: if request.auth != null && request.auth.uid == userId;\n    }\n\n    // Action Briefs are generated by the server and visible only to the user\n    // whose saved locations and source records were used for the explanation.\n    match /users/{userId}/actionBriefs/{briefId} {\n      allow read: if request.auth != null && request.auth.uid == userId;\n      allow write: if false;\n    }\n\n    // These documents contain public, provider-sourced monitoring data. The\n    // Cloud Function writes them with the Admin SDK; browsers can never write.\n    match /sourceEvents/{eventId} {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    // Approximate-area shelter lookup caches contain public provider records.\n    // The server writes them; browsers can read but can never alter them.\n    match /publicShelterSearches/{searchAreaId} {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    function signedIn() { return request.auth != null; }\n    function familyMember(familyId) {\n      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/familyGroups/$(familyId)).data.memberIds;\n    }\n\n    // Family group membership and precise coordinates are created only by\n    // authenticated Cloud Functions. Members can read their own group, but\n    // browsers cannot grant access, alter sharing state, or forge a location.\n    match /familyGroups/{familyId} {\n      allow get: if familyMember(familyId);\n      allow list, write: if false;\n      match /members/{memberId} {\n        allow read: if familyMember(familyId);\n        allow write: if false;\n      }\n      match /locations/{memberId} {\n        allow read: if familyMember(familyId);\n        allow write: if false;\n      }\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-10-18T04:01:23.922303Z","metadata":{"services":["cloud.firestore"]}}
